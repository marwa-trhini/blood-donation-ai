# BloodConnect AI Service — environment configuration (development)
# Copy to .env and fill in values. Never commit real API keys.

# LLM provider (optional — system falls back to deterministic NLP if unset)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=10000
LLM_BASE_URL=https://api.openai.com/v1
LLM_MAX_HISTORY_TURNS=6
